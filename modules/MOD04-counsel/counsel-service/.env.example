# Counsel API (MOD04) — copy to .env. CHANGE_ME values are placeholders.

# --- Server (port plan: Counsel web 3014, API 8014) ---------------------------
API_HOST=127.0.0.1
API_PORT=8014
WEB_ORIGIN=http://localhost:3014
CORS_ALLOWED_ORIGINS=["http://localhost:3014","http://127.0.0.1:3014"]

# --- Database (own database; app connects only as the non-owning role) -------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=counsel
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=CHANGE_ME
DB_OWNER_USER=counsel_owner
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_USER=counsel_app
DB_APP_PASSWORD=CHANGE_ME
SEED_DB=true

# --- Identity (platform-owned; Counsel never signs anyone in) ----------------
PLATFORM_IDENTITY_URL=http://localhost:8100
PLATFORM_SERVICE_NAME=counsel
PLATFORM_SERVICE_KEY=CHANGE_ME
PLATFORM_SESSION_COOKIE=fk_session
FORKHATRI_ENTRANCE_URL=http://localhost:3100
# Members who administer Counsel locally (comma separated member ids). In
# production the platform's governance console grants the `counsel.admin` scope.
ADMIN_MEMBER_IDS=

# --- Adapters (all replaceable; mock = local development) --------------------
# PAYMENT_PROVIDER: mock (Counsel's own stand-in) | sandbox | payment_services | <vendor>
# Everything except mock goes through shared/forkhatri-integrations.
PAYMENT_PROVIDER=mock
PAYMENTS_WEBHOOK_SECRET=CHANGE_ME
PAYMENT_SERVICES_URL=http://localhost:8016
PAYMENT_SERVICES_KEY=CHANGE_ME
# inapp,log and optionally email,sms,whatsapp,push (queued, sent by the delivery dispatcher)
NOTIFICATION_CHANNELS=inapp,log
# Senders for queued channels (shared library): console (local only) | disabled | <vendor>
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
EMAIL_PROVIDER=console
PUSH_PROVIDER=console
# JSON list of RTCIceServer objects handed to the browser for WebRTC.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Local file storage root for consultation files and evidence documents.
STORAGE_ROOT=.local-files
MAX_UPLOAD_MB=25

# --- Payout details are encrypted at rest (Fernet key; generate one per deployment)
PAYOUT_ENCRYPTION_KEY=CHANGE_ME

# --- Private files: encrypted at rest (AES-256-GCM, 32 bytes urlsafe base64) ---
FILE_ENCRYPTION_KEY=CHANGE_ME
# Malware scan of uploads: none | clamav (needs a local clamd)
MALWARE_SCANNER=none
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# --- AI assistance (optional). rules = built-in query parser; anthropic = Claude.
AI_PROVIDER=rules
ANTHROPIC_API_KEY=CHANGE_ME
COUNSEL_AI_MODEL=claude-sonnet-5
