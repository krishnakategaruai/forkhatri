# Counsel web — copy to .env.local. Values are the local development layout.
NEXT_PUBLIC_API_BASE=http://localhost:8014
# WebSocket base for the consultation room (the API, ws://). Rewritten by the tunnel script.
NEXT_PUBLIC_WS_BASE=ws://localhost:8014
NEXT_PUBLIC_IDENTITY_API=http://localhost:8100
NEXT_PUBLIC_FORKHATRI_ENTRANCE_URL=http://localhost:3100
# Set by `npm run dev:tunnel`: identity address used to redeem sign-in handoff codes.
# FORKHATRI_IDENTITY_INTERNAL_URL=http://localhost:8100
