# =============================================================================
# MangalyService — SERVICE-level configuration.
#
# This file holds only the values that are genuinely about the *application*,
# not the database. Every database/infrastructure value (DB_*, RATE_LIMIT_*,
# CREDENTIAL_HASH_*, OBJECT_STORAGE_*, PAGERDUTY_*, RETENTION_*, SMS_*) already
# lives in `07a-db-implementation/.env.example` and is read from there directly
# by `app/config/settings.py` — deliberately NOT duplicated here, because two
# files owning the same key is exactly the drift risk this module's own §4c
# precedent ("one shared implementation, never two copies") warns against.
#
# Per this project's config-placeholder convention these are illustrative
# values: dropping in real ones later is a pure data change, not a code change.
# =============================================================================

# --- Identity Bridge lifetimes (TR092-TR095, TR101) --------------------------
# Not present in the database .env because they are application behaviour, not
# database configuration.
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_CODE_DIGITS=6
PASSWORD_RESET_TTL_SECONDS=900

# [SP092 tampering row] Server-side credential-strength floor. Length-based per
# current NIST SP 800-63B guidance (length over composition rules); no source
# document in this module specifies a composition policy, so none is invented.
MIN_CREDENTIAL_LENGTH=10

# --- ForKhatri platform identity (docs/ParentApp/07-tech-reqs.md TR14-TR16) ---
# Mangaly no longer signs anyone in. It resolves the browser's ForKhatri session
# cookie through the Identity & Trust Service's internal API.
PLATFORM_IDENTITY_URL=http://localhost:8100
PLATFORM_SERVICE_NAME=mangaly
# Must equal SERVICE_KEYS["mangaly"] in platform/identity-service/.env.
PLATFORM_SERVICE_KEY=CHANGE_ME
# Production: __Host-fk_session
PLATFORM_SESSION_COOKIE_NAME=fk_session
PLATFORM_IDENTITY_TIMEOUT_SECONDS=2
FORKHATRI_ENTRANCE_URL=http://localhost:3100
# Retired interim sign-up/login/OTP/reset and the mangaly_session cookie.
# Keep false everywhere; automated tests enable it explicitly (TR15 step 5).
INTERIM_IDENTITY_ENABLED=false

# --- API ---------------------------------------------------------------------
# Enables SQLAlchemy statement echo. Never true in a real environment: statement
# logs would carry identifiers from the pre-authentication lookup path (SP103).
API_DEBUG=false

# --- Trust & safety operations (DEC-V1-028) ---------------------------------
# VENDOR BLOCKERS - the code paths exist; these keys are what stands between
# them and production:
#   PAGERDUTY_ROUTING_KEY   (in 07a-db-implementation/.env.example): while it
#                           is a CHANGE_ME placeholder, Tier 3/4 pages are
#                           logged (LogOnlyPager) and recorded in
#                           mangaly_operations.paging_event with
#                           dispatch_status='logged'; nothing leaves the host.
#   CSAM_REPORT_ENDPOINT / CSAM_REPORT_API_KEY (same file): cybercrime.gov.in's
#                           submission mechanism (API vs portal) is unconfirmed
#                           (DEC-V1-011). Until confirmed, every Tier 4 packet is
#                           stored in mangaly_operations.csam_report_packet with
#                           dispatch_status='stored_for_manual_portal' and the
#                           on-call responder is paged to submit it by hand.
#   CSAM_REPORT_FALLBACK_MODE=manual_portal_submission (same file): recorded on
#                           each packet as dispatch_mode.
# Rate limits for the report/block entry points (per account, per day).
RATE_LIMIT_REPORT_MAX_PER_DAY=20
RATE_LIMIT_BLOCK_MAX_PER_DAY=50

# --- Payments (DEC-V1-031) ---------------------------------------------------
# VENDOR BLOCKER: Razorpay account keys. While all three are CHANGE_ME the
# service runs the development sandbox gateway (no network, no money; orders are
# "paid" through POST /billing/dev/pay/{order_id}). Put real keys in .env only.
# Dashboard -> Settings -> API Keys (key id starts rzp_test_ / rzp_live_).
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Dashboard -> Settings -> Webhooks -> secret for the endpoint POST /billing/webhook
# (events: payment.captured, order.paid, payment.failed).
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
# Opt-in: shared:<adapter> routes billing through shared/forkhatri-integrations (empty = as above)
PAYMENT_GATEWAY=
PAYMENTS_WEBHOOK_SECRET=CHANGE_ME
PAYMENT_SERVICES_URL=http://localhost:8016
PAYMENT_SERVICES_KEY=CHANGE_ME
PAYMENTS_ALLOW_SANDBOX=false

# Horoscope calculation service (modules/MOD03-mangaly/horoscope-service); same token as its .env
HOROSCOPE_SERVICE_URL=http://127.0.0.1:8013
HOROSCOPE_SERVICE_TOKEN=change-me-at-least-24-characters

# AI matchmaker (DEC-V1-031): reads a family's own words about the partner they
# want. Leave CHANGE_ME to use the built-in keyword reader instead.
ANTHROPIC_API_KEY=CHANGE_ME
MATCHMAKER_MODEL=claude-opus-5
