# =============================================================================
# Vyapar (MOD01) — database configuration template.
# Copy to .env (never commit .env itself) and replace every CHANGE_ME value
# with a real one before connecting a real environment. Per this project's
# config-placeholder convention, these are illustrative placeholders, not a
# blocker.
# =============================================================================

# --- Core connection ---------------------------------------------------------
# Vyapar is a business-logic module inside the Core Platform modular monolith
# (ARCHITECTURE.md ADR-001/ADR-002) — its own Postgres DATABASE ("vyapar") on
# the platform's shared local dev server (see project-root .mcp.json), not a
# dedicated container/instance. That is a placement decision made in
# /ARCHITECTURE.md, not re-decided here.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=vyapar
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=admin
DB_OWNER_USER=vyapar_owner
DB_OWNER_PASSWORD=vyapar_owner_dev_password
# [MODULE-ARCHITECTURE-STANDARD §4] vyapar-service NEVER connects as
# DB_OWNER_USER — vyapar_app is the non-owning runtime role; RLS silently
# no-ops for a table's owner, so this distinction is load-bearing, not cosmetic.
DB_APP_USER=vyapar_app
DB_APP_PASSWORD=vyapar_app_dev_password
DB_URL=postgres://vyapar_app:vyapar_app_dev_password@localhost:5433/vyapar

# --- Connection pooling (MODULE-ARCHITECTURE-STANDARD §4 pooling-safety) ----
# If a connection pooler is deployed in transaction-mode pooling, the app MUST
# set vyapar.authz_context (and vyapar.service_role, for the outbox
# dispatcher) via SET LOCAL only, inside the same transaction as every query
# — never plain SET, which can leak one request's context onto a different
# pooled connection's next transaction.
DB_POOL_MODE=session          # session | transaction — 'transaction' only once session-affinity is independently confirmed
DB_POOL_MAX_CONNECTIONS=20

# --- RLS session variable (set per-request by the app, not here) -----------
# vyapar.authz_context is SET LOCAL by the Identity Bridge (TR050), once per
# request, to the platform-resolved member id. vyapar.service_role is set
# only by the background outbox dispatcher process, to 'dispatcher'.
# Nothing to configure here; documented so a new engineer knows these are
# runtime-set, not env vars.

# --- Seed data ---------------------------------------------------------------
SEED_DB=true
SEED_FILE_PATH=./seeds.sql

# --- Idempotency / rate-limiting (MODULE-ARCHITECTURE-STANDARD §4b/§4c) ----
IDEMPOTENCY_KEY_TTL_DAYS=7
RATE_LIMIT_ENQUIRY_PER_DAY=20        # TR022
RATE_LIMIT_REPORT_PER_DAY=10         # TR039
RATE_LIMIT_NOTIFY_STRONG_MATCH_PER_DAY=3   # TR021 fatigue cap
PARTNERSHIP_REQUEST_PENDING_CAP=10   # TR025 — standing-count check, NOT the rate_limit_counter table

# --- Platform Identity Bridge (MODULE-ARCHITECTURE-STANDARD §5b, TR050) ----
FORKHATRI_ENTRANCE_URL=https://CHANGE_ME.forkhatri.example
FK_SESSION_COOKIE_NAME=fk_session
IDENTITY_SERVICE_INTERNAL_URL=http://CHANGE_ME-identity-service.internal
IDENTITY_SERVICE_NAME=vyapar
IDENTITY_SERVICE_KEY=CHANGE_ME
IDENTITY_RESOLVE_CACHE_SECONDS=30
IDENTITY_RESOLVE_NEGATIVE_CACHE_SECONDS=5
IDENTITY_OUTAGE_READ_ONLY_WINDOW_MINUTES=15   # FR50's own stated degradation window

# --- Payment gateway (TR051 — vendor selection is a Step 9 procurement task) -
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_MODE=sandbox
PAYMENT_GATEWAY_KEY_ID=CHANGE_ME
PAYMENT_GATEWAY_KEY_SECRET=CHANGE_ME
PAYMENT_GATEWAY_WEBHOOK_SECRET=CHANGE_ME

# --- SMS/OTP (TR007 — listing-contact verification, reused from the
# platform's own shared sender; NEVER used for authentication) --------------
SMS_PROVIDER_INTERNAL_URL=http://CHANGE_ME-notification-service.internal
SMS_DLT_TEMPLATE_ID_LISTING_OTP=CHANGE_ME_transactional_route_template_id

# --- Object Storage / CDN (TR008/TR009/TR011/TR022/TR037/TR039) ------------
OBJECT_STORAGE_ENDPOINT=https://CHANGE_ME.objectstorage.example
OBJECT_STORAGE_BUCKET=vyapar-media-CHANGE_ME
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
VERIFICATION_IMAGE_DELETE_AFTER_DAYS=30   # TR008 compliance control

# --- Encryption at rest for verification identifiers (TR008) ---------------
VERIFICATION_IDENTIFIER_ENCRYPTION_KEY=CHANGE_ME_32_byte_key_base64
