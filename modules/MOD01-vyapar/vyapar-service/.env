# =============================================================================
# Vyapar API — local dev environment. Placeholder values per this project's
# config-placeholder convention (never blocking; replace CHANGE_ME before any
# real deployment). Mirrors 07a-db-implementation/.env.example's DB_* values,
# which already provisioned these exact roles/passwords in the dev database.
# =============================================================================

# --- Server ------------------------------------------------------------------
# [Port plan, product owner, 2026-09-15] Vyapar's dedicated ports: web 3011,
# API 8011 — never 3000/8000 (Mangaly), 3001/8001 (Milavn), 3100/8100
# (ForKhatri platform), or 3002/3003/8002/8080 (other sessions).
API_PORT=8011
WEB_ORIGIN=http://localhost:3011

# --- Database (vyapar_app — the ONLY role this API may connect as; RLS is
# enforced against it, never vyapar_owner) -----------------------------------
DATABASE_URL=postgres://vyapar_app:vyapar_app_dev_password@localhost:5433/vyapar

# --- Dev identity stub (TR050) ------------------------------------------------
# DEV_MODE=true: trust X-Dev-Member-Id header (dev-only stand-in for the real
# fk_session cookie). DEV_MODE=false: real fail-closed resolve against
# IDENTITY_SERVICE_INTERNAL_URL (503 on any failure, never a default member).
DEV_MODE=true
DEV_DEFAULT_MEMBER_ID=m_krishna
FORKHATRI_ENTRANCE_URL=https://CHANGE_ME.forkhatri.example
IDENTITY_SERVICE_INTERNAL_URL=http://CHANGE_ME-identity-service.internal
IDENTITY_SERVICE_KEY=CHANGE_ME
IDENTITY_RESOLVE_CACHE_SECONDS=30
IDENTITY_RESOLVE_NEGATIVE_CACHE_SECONDS=5

# --- Verification document encryption (SP008 Decision) ----------------------
VERIFICATION_IDENTIFIER_ENCRYPTION_KEY=CHANGE_ME_dev_only_32_byte_key_000000
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- Rate limits (mirrors 07a-db-implementation/.env.example) --------------
RATE_LIMIT_ENQUIRY_PER_DAY=20
RATE_LIMIT_REPORT_PER_DAY=10
RATE_LIMIT_NOTIFY_STRONG_MATCH_PER_DAY=3
PARTNERSHIP_REQUEST_PENDING_CAP=10
LISTING_ACTIVE_CAP_PER_MEMBER=20

# --- Notifications (FR21/TR021) — in-process matcher/digest loop -----------
NOTIFY_STRONG_MATCH_THRESHOLD=2.5
NOTIFY_MATCHER_INTERVAL_SECONDS=300
# Web Push swap-seam — never invoked until a real subscription flow exists.
VAPID_PUBLIC_KEY=CHANGE_ME_vapid_public_key
PAYMENT_GATEWAY=dev_sandbox
RAZORPAY_KEY_ID=CHANGE_ME_razorpay_key_id
RAZORPAY_KEY_SECRET=CHANGE_ME_razorpay_key_secret
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_dev_payment_webhook_secret
VAPID_PRIVATE_KEY=CHANGE_ME_vapid_private_key
ANALYTICS_PSEUDONYM_SECRET=CHANGE_ME_dev_analytics_pseudonym_secret
