{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-fe2/types/**/*.ts",
    ".next-fe2/dev/types/**/*.ts",
    ".next-palette/types/**/*.ts",
    ".next-palette/dev/types/**/*.ts",
    ".next-fe1/types/**/*.ts",
    ".next-fe1/dev/types/**/*.ts",
    ".next-deals/types/**/*.ts",
    ".next-deals/dev/types/**/*.ts",
    ".next-account/types/**/*.ts",
    ".next-account/dev/types/**/*.ts",
    ".next-private/types/**/*.ts",
    ".next-private/dev/types/**/*.ts",
    ".next-type/types/**/*.ts",
    ".next-type/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
