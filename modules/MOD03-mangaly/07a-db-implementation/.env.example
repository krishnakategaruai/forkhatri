# =============================================================================
# Mangaly (MOD03) — database configuration template.
# Copy to .env (never commit .env itself) and replace every CHANGE_ME value
# with a real one before connecting a real environment. Per this project's
# config-placeholder convention, these are illustrative placeholders, not a
# blocker — implementation proceeds against this file's structure now, and
# real values are dropped in later as a pure data change.
# =============================================================================

# --- Core connection ---------------------------------------------------------
# MangalyDB is architecturally its own isolated Postgres DATABASE (ARCHITECTURE.md
# ADR-002) — never a shared database with Core Platform DB / Identity DB / any
# other container's DB. For local development this project's already-running
# Postgres server (see project-root .mcp.json) is reused as the SERVER, with a
# separate `mangaly` database created on it (still logically isolated — its
# own database, own schemas, own roles — just not a separate physical server
# for local dev convenience). A real deployment gives MangalyDB its own
# server/instance entirely, per ADR-002.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mangaly
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=admin
DB_OWNER_USER=mangaly_owner
DB_OWNER_PASSWORD=mangaly_owner_dev_password
# [TR017] The application NEVER connects as DB_OWNER_USER — mangaly_app is a
# non-owning role, or RLS silently no-ops for every table it queries.
DB_APP_USER=mangaly_app
DB_APP_PASSWORD=mangaly_app_dev_password
DB_URL=postgres://mangaly_app:mangaly_app_dev_password@localhost:5433/mangaly

# --- Connection pooling (TR017 canonical RLS pooling-safety requirement) ----
# If PgBouncer (or equivalent) is deployed in transaction-mode pooling, the
# app MUST set mangaly.account_id / mangaly.authz_context via SET LOCAL only
# (never plain SET) inside the same transaction as every query — a plain SET
# under transaction-mode pooling can leak one request's context onto a
# different pooled connection's next transaction. If no pooler is in front
# of Postgres yet (e.g. local dev), this flag documents the requirement for
# whichever environment adds one later; it does not change local behavior.
# STEP 8 RELEASE BLOCKER (BLK-08-01): whichever mode is actually deployed to
# production MUST be integration-tested against a real pooler before launch —
# see 08-security-performance.md SP017/Open blockers. Not satisfied by this
# file documenting the requirement alone.
DB_POOL_MODE=session          # session | transaction — set to 'transaction' only once session-affinity is independently confirmed, per TR017
DB_POOL_MAX_CONNECTIONS=20

# --- RLS session variables (set per-request by the app, not here) ----------
# mangaly.account_id and mangaly.authz_context are SET LOCAL by Identity
# Bridge / the Authorization Engine at request time — nothing to configure
# here; documented so a new engineer knows these are runtime-set, not env vars.

# --- Seed data ---------------------------------------------------------------
SEED_DB=true
SEED_FILE_PATH=./seeds.sql

# --- Idempotency / rate-limiting (MODULE-ARCHITECTURE-STANDARD §4b/§4c) ----
IDEMPOTENCY_KEY_TTL_DAYS=7
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=604800   # 7 days, matches TR037's verifier-invite window; TR093/TR095 override per-endpoint
RATE_LIMIT_LOGIN_FAILURE_MAX=5             # per rolling 15-minute window per identifier (SP093/08-security-performance.md recommendation)
RATE_LIMIT_LOGIN_FAILURE_WINDOW_SECONDS=900
RATE_LIMIT_OTP_RESEND_MAX_PER_HOUR=5       # SP095 — SMS-bombing mitigation
RATE_LIMIT_OTP_RESEND_MIN_INTERVAL_SECONDS=30

# --- Credential hashing (v1-decisions.md "Known technical debt", BLK-08-03 closed) ---
# Argon2id is this project's pinned algorithm for mangaly_identity.account.credential_hash
# (OWASP-current default) — never an unsalted or fast general-purpose hash.
CREDENTIAL_HASH_ALGORITHM=argon2id
CREDENTIAL_HASH_TIME_COST=3
CREDENTIAL_HASH_MEMORY_COST_KB=65536
CREDENTIAL_HASH_PARALLELISM=4

# --- Object Storage (profile media, verification evidence — TR006/TR040) ---
OBJECT_STORAGE_ENDPOINT=https://CHANGE_ME.objectstorage.example
OBJECT_STORAGE_BUCKET=mangaly-media-CHANGE_ME
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300   # TR006's short-TTL signed URL

# --- On-call paging (DEC-V1-009/DEC-V1-011, TR065) — PagerDuty, named concretely ---
# Vendor is resolved (v1-decisions.md DEC-V1-011, 2026-09-13) — PagerDuty specifically,
# using its Events API v2 (routing-key model), not a generic placeholder vendor.
PAGING_VENDOR=pagerduty
PAGERDUTY_EVENTS_API_URL=https://events.pagerduty.com/v2/enqueue
PAGERDUTY_ROUTING_KEY=CHANGE_ME_tier3_4_integration_routing_key
PAGERDUTY_ESCALATION_POLICY_ID=CHANGE_ME

# --- CSAM external reporting channel (DEC-V1-009/DEC-V1-011, POCSO Rule 11) -
# Packet field schema is resolved (v1-decisions.md DEC-V1-011) — modeled on
# NCMEC's real CyberTipline ESP schema field categories, adapted to India's
# actual mandatory channel (cybercrime.gov.in / SJPU), per POCSO Rule 11(2).
CSAM_REPORT_ENDPOINT=https://cybercrime.gov.in/CHANGE_ME_actual_intake_endpoint
CSAM_REPORT_API_KEY=CHANGE_ME
CSAM_REPORT_FALLBACK_MODE=manual_portal_submission   # used if no programmatic API exists at Step 9 confirmation time

# --- Data retention (DEC-V1-010, 2026-09-13 — resolves the former DPDP-gated blocker) ---
RETENTION_POST_DELETION_GRACE_DAYS=30
RETENTION_POST_DELETION_ERASURE_DAYS=90
RETENTION_PRE_ERASURE_NOTICE_HOURS=48        # DPDP Rules 2025 Rule 8's own mandatory notice
RETENTION_INACTIVE_ACCOUNT_CEILING_DAYS=1095 # 3 years, DPDP large-platform inactivity ceiling adopted as V1's own discipline
RETENTION_AUDIT_LOG_MIN_DAYS=365             # DPDP Rules 2025 processing-log floor
RETENTION_SAFETY_EVIDENCE_POST_CASE_CLOSURE_DAYS=180

# --- SMS/OTP delivery (TR095 — DLT-route + fallback channel) ----------------
SMS_PROVIDER=CHANGE_ME
SMS_DLT_TEMPLATE_ID_OTP=CHANGE_ME_transactional_route_template_id
OTP_FALLBACK_CHANNEL=email   # email | whatsapp — per TR095's >99% effective-delivery mitigation
