# Local development values (git-ignored). Placeholders and explanations: .env.example
PLATFORM_IDENTITY_URL=http://localhost:8100
PLATFORM_SERVICE_NAME=mangaly
PLATFORM_SERVICE_KEY=CHANGE_ME_dev_mangaly_service_key
PLATFORM_SESSION_COOKIE_NAME=fk_session
FORKHATRI_ENTRANCE_URL=https://amendment-sleep-conducting-adjustment.trycloudflare.com
INTERIM_IDENTITY_ENABLED=false

# Development only: *.localhost origins, one per signed-in family member (see settings.py).
CORS_ALLOWED_ORIGIN_REGEX=^http://[a-z0-9-]+\.localhost:3000$

# Temporary Cloudflare quick-tunnel overrides (2026-09-25). PLATFORM_IDENTITY_URL
# stays localhost:8100 on purpose — this API-to-API call runs server-side inside
# this machine, never through the tunnel. FORKHATRI_ENTRANCE_URL is sent to the
# browser (e.g. "sign in" redirects), so it must be the reachable tunnel address.
# CORS_ALLOWED_ORIGINS adds the tunnelled mangaly-web origin so its browser calls
# aren't rejected (the fk_session cookie still won't cross tunnels — see
# identity-service/.env). Remove once torn down.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://keyboard-relaxation-bidder-disclaimer.trycloudflare.com"]
