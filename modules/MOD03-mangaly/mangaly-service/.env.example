# =============================================================================
# MangalyService — SERVICE-level configuration.
#
# This file holds only the values that are genuinely about the *application*,
# not the database. Every database/infrastructure value (DB_*, RATE_LIMIT_*,
# CREDENTIAL_HASH_*, OBJECT_STORAGE_*, PAGERDUTY_*, RETENTION_*, SMS_*) already
# lives in `07a-db-implementation/.env.example` and is read from there directly
# by `app/config/settings.py` — deliberately NOT duplicated here, because two
# files owning the same key is exactly the drift risk this module's own §4c
# precedent ("one shared implementation, never two copies") warns against.
#
# Per this project's config-placeholder convention these are illustrative
# values: dropping in real ones later is a pure data change, not a code change.
# =============================================================================

# --- Identity Bridge lifetimes (TR092-TR095, TR101) --------------------------
# Not present in the database .env because they are application behaviour, not
# database configuration.
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_CODE_DIGITS=6
PASSWORD_RESET_TTL_SECONDS=900

# [SP092 tampering row] Server-side credential-strength floor. Length-based per
# current NIST SP 800-63B guidance (length over composition rules); no source
# document in this module specifies a composition policy, so none is invented.
MIN_CREDENTIAL_LENGTH=10

# --- ForKhatri platform identity (docs/ParentApp/07-tech-reqs.md TR14-TR16) ---
# Mangaly no longer signs anyone in. It resolves the browser's ForKhatri session
# cookie through the Identity & Trust Service's internal API.
PLATFORM_IDENTITY_URL=http://localhost:8100
PLATFORM_SERVICE_NAME=mangaly
# Must equal SERVICE_KEYS["mangaly"] in platform/identity-service/.env.
PLATFORM_SERVICE_KEY=CHANGE_ME
# Production: __Host-fk_session
PLATFORM_SESSION_COOKIE_NAME=fk_session
PLATFORM_IDENTITY_TIMEOUT_SECONDS=2
FORKHATRI_ENTRANCE_URL=http://localhost:3100
# Retired interim sign-up/login/OTP/reset and the mangaly_session cookie.
# Keep false everywhere; automated tests enable it explicitly (TR15 step 5).
INTERIM_IDENTITY_ENABLED=false

# --- API ---------------------------------------------------------------------
# Enables SQLAlchemy statement echo. Never true in a real environment: statement
# logs would carry identifiers from the pre-authentication lookup path (SP103).
API_DEBUG=false
