# Mangaly web — copy to .env.local. Every value is public (NEXT_PUBLIC_*): no
# secret may ever go in this file.

# MangalyService (FastAPI).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ForKhatri web entrance: sign-in, sign-up and the module hub (07-tech-reqs TR16/TR21).
NEXT_PUBLIC_FORKHATRI_ENTRANCE_URL=http://localhost:3100

# ForKhatri Identity & Trust Service public API, used only for sign-out (TR13/TR16).
NEXT_PUBLIC_IDENTITY_API=http://localhost:8100
