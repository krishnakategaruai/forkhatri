# =============================================================================
# Milavn (MOD02) — local/dev database configuration.
# Copy to .env and fill in real local values before running init.sh.
# Per this project's config-placeholder convention: CHANGE_ME values are
# non-functional placeholders, not real credentials — never commit a real
# .env file.
#
# IMPORTANT: unlike Mangaly (MOD03), which owns an isolated database, Milavn
# lives in the Core Platform monolith's SHARED database alongside Vyapar and
# Dashboard (/ARCHITECTURE.md ADR-001/ADR-002) — DB_NAME below should point
# at that same shared Core Platform database, not a Milavn-only one. This
# project's local dev Postgres already runs a shared database
# ("forkhatridb") per the repo root .mcp.json — the default below matches it
# so a developer can run this module's init.sh against the same instance
# every other Core Platform module uses, without creating a second database.
# =============================================================================

DB_HOST=localhost
DB_PORT=5433
DB_NAME=forkhatridb

# Admin connection (cluster-wide role creation only — see init.sh Step 2).
# This project's local dev Postgres default superuser; replace for any other
# environment.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Migration/owner role — owns every milavn_* schema/table. Never the role the
# running application connects as (MODULE-ARCHITECTURE-STANDARD §4 first
# named RLS failure mode: RLS is bypassed entirely for a table's owner).
DB_OWNER_USER=milavn_owner
DB_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD

# Application runtime role — the ONLY role Milavn's own FastAPI process
# connects as. Non-owning; RLS policies apply to it. Every request's
# transaction must SET LOCAL milavn.member_id / milavn.permission_scope /
# milavn.internal_service before querying (see schema.sql comments and
# README.md "RLS session variables").
DB_APP_USER=milavn_app
DB_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# Seed data (development/test only — never run against a production or
# shared-staging database).
SEED_DB=false
SEED_FILE_PATH=./seeds.sql

# Derived connection string the application actually uses at runtime
# (constructed here only for convenience; the app should read the discrete
# DB_* values above, not parse this string).
DB_URL=postgres://milavn_app:CHANGE_ME_APP_PASSWORD@localhost:5433/forkhatridb
