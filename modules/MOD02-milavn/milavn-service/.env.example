# Milavn service — service-level configuration. Copy to `.env`.
# Database values live in ../07a-db-implementation/.env (same DB_* names).
# CHANGE_ME values are placeholders a real deployment overwrites.

# API
API_PORT=8001
CORS_ALLOWED_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]
WEB_BASE_URL=http://localhost:3001

# ForKhatri platform identity (docs/ParentApp/07-tech-reqs.md TR12-TR15, TR24)
PLATFORM_IDENTITY_URL=http://localhost:8100
PLATFORM_SERVICE_NAME=milavn
PLATFORM_SERVICE_KEY=CHANGE_ME
PLATFORM_SESSION_COOKIE=fk_session
FORKHATRI_ENTRANCE_URL=http://localhost:3100

# Legacy X-Milavn-Member-Id development identity. Keep false; automated tests
# enable it explicitly.
DEV_IDENTITY_ENABLED=false

# Place search (shared utility). nominatim = free OpenStreetMap data; point PLACES_BASE_URL at your own
# server for heavy use. The public server needs a real contact: set PLACES_CONTACT_EMAIL. "none" = off.
PLACES_PROVIDER=nominatim
PLACES_BASE_URL=https://nominatim.openstreetmap.org
PLACES_USER_AGENT=ForKhatri-Milavn/1.0
PLACES_CONTACT_EMAIL=

# Large events: the "book a one-to-one with this expert" link (Counsel). Empty hides it. Use https; "{member_id}" is
# replaced by the organizer's ForKhatri member id.
COUNSEL_BOOKING_URL=

# Online events: minutes before the start when the join link appears for people who are going (organizers always see it).
ONLINE_JOIN_OPEN_MINUTES=15

# Circle posts and albums: photos and files per post, size caps (MB), accepted file types (JSON list of extensions),
# and how many photos one album upload may carry.
CIRCLE_POST_MAX_PHOTOS=10
CIRCLE_POST_MAX_FILES=5
CIRCLE_PHOTO_MAX_MB=10
CIRCLE_FILE_MAX_MB=15
CIRCLE_FILE_TYPES=["pdf","doc","docx","xls","xlsx","ppt","pptx","txt"]
CIRCLE_ALBUM_MAX_PHOTOS_PER_UPLOAD=20
