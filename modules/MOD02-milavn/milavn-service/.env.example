# Milavn service — service-level configuration. Copy to `.env`.
# Database values live in ../07a-db-implementation/.env (same DB_* names).
# CHANGE_ME values are placeholders a real deployment overwrites.

# API
API_PORT=8001
CORS_ALLOWED_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]
WEB_BASE_URL=http://localhost:3001

# ForKhatri platform identity (docs/ParentApp/07-tech-reqs.md TR12-TR15, TR24)
PLATFORM_IDENTITY_URL=http://localhost:8100
PLATFORM_SERVICE_NAME=milavn
PLATFORM_SERVICE_KEY=CHANGE_ME
PLATFORM_SESSION_COOKIE=fk_session
FORKHATRI_ENTRANCE_URL=http://localhost:3100

# Legacy X-Milavn-Member-Id development identity. Keep false; automated tests
# enable it explicitly.
DEV_IDENTITY_ENABLED=false
