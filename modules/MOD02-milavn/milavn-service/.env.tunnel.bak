# Local development values (not committed — see .env.example).
PLATFORM_IDENTITY_URL=http://localhost:8100
PLATFORM_SERVICE_NAME=milavn
PLATFORM_SERVICE_KEY=CHANGE_ME_dev_milavn_service_key
PLATFORM_SESSION_COOKIE=fk_session
FORKHATRI_ENTRANCE_URL=https://amendment-sleep-conducting-adjustment.trycloudflare.com
DEV_IDENTITY_ENABLED=false

# FR102 paid spots: development test checkout (no money moves). Real deployments use payment_services or none.
PAYMENTS_PROVIDER=sandbox

# Temporary Cloudflare quick-tunnel overrides (2026-09-25). PLATFORM_IDENTITY_URL
# stays localhost:8100 on purpose — that call runs server-side inside this
# machine, never through the tunnel. FORKHATRI_ENTRANCE_URL above is sent to the
# browser, so it must be the reachable tunnel address. CORS_ALLOWED_ORIGINS adds
# the tunnelled milavn-web origin (the fk_session cookie still won't cross
# tunnels — see identity-service/.env). Remove once torn down.
CORS_ALLOWED_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001","https://stages-passenger-examining-brunswick.trycloudflare.com"]
