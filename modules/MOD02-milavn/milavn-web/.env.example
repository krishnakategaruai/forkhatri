# Milavn web — copy to .env.local. Placeholders are the local development values.
# Milavn API (FastAPI)
NEXT_PUBLIC_API_BASE=http://localhost:8001
# ForKhatri Identity & Trust Service public API (sign-out) — TR13/TR16
NEXT_PUBLIC_IDENTITY_API=http://localhost:8100
# ForKhatri web entrance (sign-in, hub, return_to) — TR16/TR17
NEXT_PUBLIC_FORKHATRI_ENTRANCE_URL=http://localhost:3100

# Set by `npm run dev:tunnel`: identity service address this server uses to redeem
# sign-in handoff codes from the hub (see proxy.ts). Leave unset otherwise.
# FORKHATRI_IDENTITY_INTERNAL_URL=http://localhost:8100
