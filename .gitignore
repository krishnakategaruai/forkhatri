# ForKhatri — root .gitignore
# Applies across platform/ and every modules/MOD*/ directory.

# --- Secrets / local environment ---------------------------------------------
.env
.env.local
.env.*.local
.env.tunnel.bak
.env.local.tunnel.bak
!.env.example
!.env.*.example

# --- Logs ----------------------------------------------------------------
*.log
*.log.err
.logs/
.tunnel-logs/
.dev-*.log

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Node / Next.js -----------------------------------------------------
node_modules/
.next/
out/
dist/
build/
.turbo/

# --- Editors / OS ---------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/*
!.vscode/extensions.json

# --- Backups / scratch --------------------------------------------------------
*.bak
*.tmp
*.orig

# tunnel launcher log (scripts/start-tunnels.ps1)
scripts/.tunnel.log*

# --- Added 2026-11-16: things that must never be committed ----------------------
# Build caches (any renamed or stale copy of .next) and TypeScript build info
.next-*/
*.tsbuildinfo
# Uploaded test photos and media kept on local disk by the services
.local-media/
.local-ephemeris/
# Python caches anywhere
**/__pycache__/
# Local logs and scratch from the tunnel launcher and dev runs
.tunnel-logs/
*-out.log
# Local secrets and keys
*.pem
*.key
deploy/secrets/*
!deploy/secrets/.gitignore
!deploy/secrets/*.example
# Local Claude Code settings and per-machine files
.claude/settings.local.json
