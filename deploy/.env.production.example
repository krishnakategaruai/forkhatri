# ForKhatri production environment — reference of every variable the stack reads.
#
# Do not fill this in by hand. deploy/scripts/generate-secrets.sh reads the owner
# inputs from deploy/secrets/owner-inputs.env, generates every secret below, and
# writes deploy/secrets/.env.production (git-ignored, mode 600). This file only
# documents the shape. Values are single-quoted so Docker Compose never
# interpolates them.

# --- Owner inputs (from deploy/secrets/owner-inputs.env) ---------------------
DOMAIN='CHANGE_ME.example'
CLOUDFLARE_TUNNEL_TOKEN='CHANGE_ME'
RESEND_API_KEY='CHANGE_ME'
EMAIL_FROM='ForKhatri <no-reply@CHANGE_ME.example>'
# Optional off-server backups (all four or none).
R2_ACCOUNT_ID=''
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''
R2_BUCKET=''

# --- Derived from DOMAIN ------------------------------------------------------
# One public origin for the entrance, both module zones and all three APIs (TR22).
PUBLIC_ORIGIN='https://CHANGE_ME.example'
PUBLIC_SCHEME='https'

# --- Session cookie (TR12) ----------------------------------------------------
SESSION_COOKIE_NAME='__Host-fk_session'
SESSION_COOKIE_SECURE='true'
# true ONLY for the local http rehearsal (deploy/docker-compose.local-test.yml).
LOCAL_HTTP_TEST='false'

# --- Code delivery (TR19) -----------------------------------------------------
# SMS is not funded yet: phone members sign in with a password; codes go by email.
SMS_PROVIDER='disabled'
EMAIL_PROVIDER='resend'

# --- Generated secrets (32 random bytes each, hex) ----------------------------
POSTGRES_PASSWORD='CHANGE_ME'
IDENTITY_OWNER_PASSWORD='CHANGE_ME'
IDENTITY_APP_PASSWORD='CHANGE_ME'
MANGALY_OWNER_PASSWORD='CHANGE_ME'
MANGALY_APP_PASSWORD='CHANGE_ME'
MILAVN_OWNER_PASSWORD='CHANGE_ME'
MILAVN_APP_PASSWORD='CHANGE_ME'
OTP_PEPPER='CHANGE_ME'
# Must match on both sides of TR14: identity SERVICE_KEYS and each module's PLATFORM_SERVICE_KEY.
MANGALY_SERVICE_KEY='CHANGE_ME'
MILAVN_SERVICE_KEY='CHANGE_ME'

# --- Operations ---------------------------------------------------------------
COMPOSE_PROJECT_NAME='forkhatri'
# Set by deploy/scripts/remote-release.sh to the release folder name; tags the images.
RELEASE_ID='manual'
BACKUP_KEEP_DAYS='14'
# Pin exact tags after the first successful deploy (docker image ls).
POSTGRES_IMAGE='postgres:18-bookworm'
CADDY_IMAGE='caddy:2.11-alpine'
CLOUDFLARED_IMAGE='cloudflare/cloudflared:latest'
