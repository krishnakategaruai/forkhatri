# ForKhatri deployment — the only values a human supplies.
# Copy to deploy/secrets/owner-inputs.env (git-ignored) and fill in. Never paste
# these into chat, tickets or commits. deploy/scripts/generate-secrets.sh reads
# this file and writes deploy/secrets/.env.production.

# Public domain ForKhatri is served on, without scheme or path (e.g. forkhatri.in).
DOMAIN=

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install command: the long token after --token.
CLOUDFLARE_TUNNEL_TOKEN=

# Resend > API Keys > Create (permission "Sending access", restricted to your domain).
RESEND_API_KEY=

# Sender for sign-in codes, on the domain verified in Resend, e.g. ForKhatri <no-reply@forkhatri.in>.
EMAIL_FROM=

# Public IPv4 address of the Oracle VM (Compute > Instances > your instance).
SERVER_IP=

# SSH user of the VM; Oracle's Ubuntu images use ubuntu.
SERVER_USER=ubuntu

# --- Off-server backups to Cloudflare R2 (optional, STRONGLY recommended) ----
# A free VM can be reclaimed or lost; without these, backups live only on that VM.
# Cloudflare dashboard > R2 > Overview: the Account ID shown on the right.
R2_ACCOUNT_ID=
# R2 > Manage API tokens > Create API token (Object Read & Write, this bucket only): Access Key ID.
R2_ACCESS_KEY_ID=
# Same token: Secret Access Key (shown once).
R2_SECRET_ACCESS_KEY=
# R2 > Create bucket, e.g. forkhatri-backups (private).
R2_BUCKET=
