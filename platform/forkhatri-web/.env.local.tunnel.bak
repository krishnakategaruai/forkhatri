# Development only (git-ignored). Shows the "Act as" member switcher; production builds compile it out.
NEXT_PUBLIC_DEV_TOOLS=true

# Temporary Cloudflare quick-tunnel override (2026-09-25): points this web app's
# identity calls at the tunnelled identity-service instead of localhost:8100.
# Requires restarting the entrance dev server to take effect (NEXT_PUBLIC_ vars
# are read at startup). Remove once the tunnels are torn down.
NEXT_PUBLIC_IDENTITY_API=https://min-syndicate-tattoo-assessments.trycloudflare.com
