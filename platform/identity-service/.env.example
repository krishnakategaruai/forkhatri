# ForKhatri Identity & Trust Service. Copy to .env and replace every CHANGE_ME.
# Without a .env file the service runs with development defaults.

# development | production (production refuses placeholder secrets and dev switches)
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5433
DB_NAME=forkhatri_identity
DB_APP_USER=identity_app
DB_APP_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10

API_HOST=127.0.0.1
API_PORT=8100
CORS_ALLOWED_ORIGINS=["http://localhost:3100","http://localhost:3000","http://localhost:3001"]

# Production: SESSION_COOKIE_NAME=__Host-fk_session and SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=fk_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Optional, unset by default (host-only cookie, today's behaviour). Only needed
# when every module is fronted under its own hostname that still shares one real
# parent domain you own (e.g. modules tunnelled as *.yourdomain.com) and the
# session must ride across them. Never a public suffix like trycloudflare.com —
# browsers reject that as a cookie Domain. Forbidden in production (the
# __Host- cookie prefix disallows a Domain attribute).
SESSION_COOKIE_DOMAIN=
# lax (default) | strict | none. Only raise to "none" (with SESSION_COOKIE_SECURE=true)
# when a module's web origin must call this API cross-site via fetch/XHR — e.g.
# each module on its own tunnel hostname. Forbidden in production.
SESSION_COOKIE_SAMESITE=lax

OTP_PEPPER=CHANGE_ME
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_VERIFIED_GRACE_SECONDS=600
# Development only: return the one-time code in the API response.
DEV_EXPOSE_OTP=true
# console = log the code (development only). Real providers: see delivery.py.
SMS_PROVIDER=console
EMAIL_PROVIDER=console
# With SMS_PROVIDER/EMAIL_PROVIDER=shared: the shared/forkhatri-integrations adapter to use
SHARED_SMS_SENDER=disabled
SHARED_EMAIL_SENDER=disabled
SMS_DLT_TEMPLATE_ID=

# Development only: the /dev/v1 member switcher ("Act as" in the entrance). Mounted
# only with ENVIRONMENT=development; production refuses to start while it is true.
DEV_TOOLS_ENABLED=false
# Development only, optional: at least 32 characters. Tests that send it as
# X-ForKhatri-Dev-Token receive the session token in the body (scripts/dev_session.py).
DEV_TOOLS_TOKEN=

# Rate limits (TR20). Contract defaults shown; only local development may raise them.
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_CODE_PER_IDENTIFIER=5
RATE_LIMIT_CODE_PER_IP=30
RATE_LIMIT_VERIFY_PER_CHALLENGE=10
RATE_LIMIT_PASSWORD_PER_IDENTIFIER=10
RATE_LIMIT_PASSWORD_PER_IP=30

# Per-module service credentials for /internal/v1 (TR14).
SERVICE_KEYS={"mangaly":"CHANGE_ME","milavn":"CHANGE_ME"}
SERVICES_RECEIVING_IDENTIFIERS=["mangaly"]

# Where each available module's web surface lives in this environment (TR18/TR22).
MODULE_ENTRY_URLS={"mangaly":"http://localhost:3000","milavn":"http://localhost:3001"}

# Members dashboard (/insights, open to every signed-in member).
# Each module's API, asked server to server (with its SERVICE_KEYS entry) for the
# facts it owns: gender, date of birth and city. No code default: a module missing
# here is not asked, and the dashboard shows its numbers as missing.
MODULE_API_URLS={"mangaly":"http://CHANGE_ME_mangaly_api_host","milavn":"http://CHANGE_ME_milavn_api_host"}

# Admin & Governance Console (/admin on the entrance): extra module APIs whose admin
# views (TR-PLAT-01 manifest at {base}/{module}/admin/manifest) the console federates,
# on top of MODULE_API_URLS. The console forwards the admin's own session to them.
ADMIN_MODULE_API_URLS={"vyapar":"http://CHANGE_ME_vyapar_api_host"}
ADMIN_GATEWAY_TIMEOUT_SECONDS=8
