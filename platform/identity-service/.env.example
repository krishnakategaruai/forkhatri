# ForKhatri Identity & Trust Service. Copy to .env and replace every CHANGE_ME.
# Without a .env file the service runs with development defaults.

# development | production (production refuses placeholder secrets and dev switches)
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5433
DB_NAME=forkhatri_identity
DB_APP_USER=identity_app
DB_APP_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10

API_HOST=127.0.0.1
API_PORT=8100
CORS_ALLOWED_ORIGINS=["http://localhost:3100","http://localhost:3000","http://localhost:3001"]

# Production: SESSION_COOKIE_NAME=__Host-fk_session and SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=fk_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30

OTP_PEPPER=CHANGE_ME
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_VERIFIED_GRACE_SECONDS=600
# Development only: return the one-time code in the API response.
DEV_EXPOSE_OTP=true
# console = log the code (development only). Real providers: see delivery.py.
SMS_PROVIDER=console
EMAIL_PROVIDER=console

# Development only: the /dev/v1 member switcher ("Act as" in the entrance). Mounted
# only with ENVIRONMENT=development; production refuses to start while it is true.
DEV_TOOLS_ENABLED=false
# Development only, optional: at least 32 characters. Tests that send it as
# X-ForKhatri-Dev-Token receive the session token in the body (scripts/dev_session.py).
DEV_TOOLS_TOKEN=

# Rate limits (TR20). Contract defaults shown; only local development may raise them.
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_CODE_PER_IDENTIFIER=5
RATE_LIMIT_CODE_PER_IP=30
RATE_LIMIT_VERIFY_PER_CHALLENGE=10
RATE_LIMIT_PASSWORD_PER_IDENTIFIER=10
RATE_LIMIT_PASSWORD_PER_IP=30

# Per-module service credentials for /internal/v1 (TR14).
SERVICE_KEYS={"mangaly":"CHANGE_ME","milavn":"CHANGE_ME"}
SERVICES_RECEIVING_IDENTIFIERS=["mangaly"]

# Where each available module's web surface lives in this environment (TR18/TR22).
MODULE_ENTRY_URLS={"mangaly":"http://localhost:3000","milavn":"http://localhost:3001"}
