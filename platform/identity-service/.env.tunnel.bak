# Local development overrides (git-ignored). Everything else uses development defaults.
# Several automated browser tests share 127.0.0.1 and the two seeded members,
# so the per-IP and per-member limits are raised locally only.
RATE_LIMIT_CODE_PER_IP=500
RATE_LIMIT_PASSWORD_PER_IP=500
RATE_LIMIT_PASSWORD_PER_IDENTIFIER=200

# Development tools: /dev/v1 member switcher (never in production).
DEV_TOOLS_ENABLED=true
DEV_TOOLS_TOKEN=NWxbrXFBJf0JhGDWCZQ7m2onN5BlC941GhigQNfkwklRDtEQ

# Temporary Cloudflare quick-tunnel origins added on top of the localhost defaults
# (2026-09-25) so the entrance, Mangaly-web and Milavn-web tunnels can call this API
# without a CORS rejection. These are random per-tunnel hostnames, not a shared
# domain, so the fk_session cookie still will NOT cross between them — sign-in
# started on one tunnel will not be recognised on another. Remove once the tunnels
# are torn down.
CORS_ALLOWED_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100","http://localhost:3000","http://localhost:3001","https://amendment-sleep-conducting-adjustment.trycloudflare.com","https://keyboard-relaxation-bidder-disclaimer.trycloudflare.com","https://stages-passenger-examining-brunswick.trycloudflare.com"]
MODULE_ENTRY_URLS={"mangaly":"https://keyboard-relaxation-bidder-disclaimer.trycloudflare.com","milavn":"https://stages-passenger-examining-brunswick.trycloudflare.com","vyapar":"http://localhost:3011"}
